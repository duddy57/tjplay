---
import { iptvCatalogue, iptvWhatsAppHref } from '@/data/iptv';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import esporte01 from '@/assets/logos/esporte-01.png';
import esporte02 from '@/assets/logos/esporte-02.png';
import esporte03 from '@/assets/logos/esporte-03.png';
import esporte04 from '@/assets/logos/esporte-04.png';
import esporte05 from '@/assets/logos/esporte-05.png';
import kids01 from '@/assets/logos/kids-01.png';
import kids02 from '@/assets/logos/kids-02.png';
import kids03 from '@/assets/logos/kids-03.png';
import kids04 from '@/assets/logos/kids-04.png';
import kids05 from '@/assets/logos/kids-05.png';
import movies01 from '@/assets/logos/movies-01.png';
import movies02 from '@/assets/logos/movies-02.png';
import movies03 from '@/assets/logos/movies-03.png';
import movies04 from '@/assets/logos/movies-04.png';
import movies05 from '@/assets/logos/movies-05.png';

const approvedLogos: Record<string, ImageMetadata> = {
  'esporte-01': esporte01,
  'esporte-02': esporte02,
  'esporte-03': esporte03,
  'esporte-04': esporte04,
  'esporte-05': esporte05,
  'kids-01': kids01,
  'kids-02': kids02,
  'kids-03': kids03,
  'kids-04': kids04,
  'kids-05': kids05,
  'movies-01': movies01,
  'movies-02': movies02,
  'movies-03': movies03,
  'movies-04': movies04,
  'movies-05': movies05,
};
---

<section id="catalogo" class="shell overflow-hidden py-20 sm:py-24 md:py-36" aria-labelledby="catalogo-title">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <p class="font-mono text-label text-signal-mid uppercase">{iptvCatalogue.eyebrow}</p>
      <h2
        id="catalogo-title"
        class="mt-5 max-w-[9ch] whitespace-pre-line font-display text-title font-bold leading-[0.92] text-bone">
        {iptvCatalogue.title}
      </h2>
      <p class="mt-6 max-w-[32ch] text-mute">{iptvCatalogue.body}</p>
    </div>

    <div class="space-y-7 sm:space-y-8 lg:col-span-8 lg:col-start-5" aria-label="Categorias de conteúdo">
      {iptvCatalogue.rails.map((rail, index) => (
        <div aria-labelledby={`catalogue-rail-${index}`}>
          <div class="mb-3 flex items-center gap-3">
            <span class="size-2 rounded-full bg-signal-mid" aria-hidden="true"></span>
            <h3 id={`catalogue-rail-${index}`} class="font-mono text-label text-bone uppercase">
              {rail.label}
            </h3>
          </div>

          <div class="iptv-marquee" data-direction={rail.direction}>
            <div
              class:list={[
                'iptv-marquee-track',
                rail.direction === 'right' ? 'iptv-marquee-track-right' : 'iptv-marquee-track-left',
              ]}>
              <ul class="iptv-marquee-list" role="list">
                {rail.items.map((item) => (
                  <li class="iptv-marquee-item">
                    {item.logoKey && approvedLogos[item.logoKey] ? (
                      <Image src={approvedLogos[item.logoKey]} alt={item.label} class="iptv-marquee-logo" />
                    ) : (
                      <>
                        <span class="iptv-marquee-mark" aria-hidden="true">
                          ✦
                        </span>
                        <span>{item.label}</span>
                      </>
                    )}
                  </li>
                ))}
              </ul>
              <ul class="iptv-marquee-list" role="list" aria-hidden="true">
                {rail.items.map((item) => (
                  <li class="iptv-marquee-item">
                    {item.logoKey && approvedLogos[item.logoKey] ? (
                      <Image src={approvedLogos[item.logoKey]} alt="" aria-hidden="true" class="iptv-marquee-logo" />
                    ) : (
                      <>
                        <span class="iptv-marquee-mark" aria-hidden="true">
                          ✦
                        </span>
                        <span>{item.label}</span>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-10 border-l-2 border-signal-mid pl-4 sm:mt-12 lg:ml-[41.666667%] lg:max-w-[32rem]">
    <p class="text-sm text-dim">{iptvCatalogue.confirmationNote}</p>
    <a
      href={iptvWhatsAppHref}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex text-sm font-medium text-signal-mid underline decoration-signal-mid/40 underline-offset-4 transition-colors hover:text-bone">
      Confirmar opções pelo WhatsApp ↗
    </a>
  </div>
</section>

<style>
  .iptv-marquee {
    width: 100%;
    overflow: hidden;
    border-top: 1px solid var(--color-line-strong);
    border-bottom: 1px solid var(--color-line-strong);
    padding-block: 1rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .iptv-marquee-track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    animation-name: iptv-marquee-scroll;
    animation-duration: 30s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: normal;
    will-change: transform;
  }

  .iptv-marquee-track-right {
    animation-direction: reverse;
  }

  .iptv-marquee:hover .iptv-marquee-track {
    animation-play-state: paused;
  }

  .iptv-marquee-list {
    display: flex;
    width: max-content;
    flex-shrink: 0;
    gap: 0.75rem;
  }

  .iptv-marquee-item {
    display: flex;
    width: 10rem;
    flex: 0 0 10rem;
    align-items: center;
    gap: 0.75rem;
    padding-inline: 0.25rem;
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .iptv-marquee-mark {
    width: 0.4rem;
    height: 0.4rem;
    flex: 0 0 0.4rem;
    border-radius: 999px;
    background: var(--color-signal-mid);
  }

  :global(.iptv-marquee-logo) {
    display: block;
    width: auto;
    max-width: 8rem;
    height: 2.25rem;
    object-fit: contain;
  }

  @keyframes iptv-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iptv-marquee-track {
      animation-play-state: paused;
    }
  }

  @media (width >= 48rem) {
    .iptv-marquee {
      padding-block: 1.25rem;
    }
    .iptv-marquee-item {
      width: 12rem;
      flex-basis: 12rem;
    }
  }
</style>
