---
import { iptvProof } from '@/data/iptv';
---

<section class="bg-ink-3 py-16 sm:py-20 md:py-28" aria-labelledby="prova-title"><div class="shell grid gap-8 md:grid-cols-12 md:items-end md:gap-10"><div class="md:col-span-3"><p class="font-mono text-label text-signal-mid uppercase">{iptvProof.eyebrow}</p><div class="mt-6 text-5xl text-signal-mid sm:mt-8 sm:text-6xl">“</div></div><div class="md:col-span-8 md:col-start-5"><h2 id="prova-title" class="max-w-[22ch] font-display text-subtitle font-medium leading-tight text-bone">{iptvProof.quote}</h2><p class="mt-5 text-sm text-mute sm:mt-6">{iptvProof.name}</p></div></div></section>
