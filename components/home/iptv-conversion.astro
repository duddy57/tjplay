---
import Button from '@/components/shared/ui/button.astro';
import { iptvWhatsAppHref } from '@/data/iptv';
---

<section id="contato" class="relative overflow-hidden py-20 sm:py-24 md:py-36" aria-labelledby="contato-title"><div class="pointer-events-none absolute -right-32 top-1/2 -z-10 size-96 -translate-y-1/2 bg-signal/20 blur-3xl"></div><div class="shell flex flex-col items-start justify-between gap-8 md:flex-row md:items-end md:gap-10"><div><p class="font-mono text-label text-signal-mid uppercase">Pronto para descobrir?</p><h2 id="contato-title" class="mt-5 max-w-[10ch] font-display text-display font-bold leading-[0.9] text-bone">Seu próximo programa começa aqui.</h2><p class="mt-6 max-w-[38ch] text-lead text-mute sm:mt-7">Fale com nosso atendimento para conhecer a experiência e tirar suas dúvidas.</p></div><div class="flex shrink-0 flex-col items-start gap-3 sm:gap-4"><Button label="Falar pelo WhatsApp" href={iptvWhatsAppHref} target="_blank" rel="noopener noreferrer" /><p class="max-w-[24ch] text-xs text-dim">Atendimento direto pelo WhatsApp.</p></div></div></section>
