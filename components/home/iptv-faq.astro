---
import Icon from '@/components/shared/icons/icon.astro';
import { iptvFaqs } from '@/data/iptv';
---

<section id="duvidas" class="shell py-20 sm:py-24 md:py-36" aria-labelledby="duvidas-title"><div class="grid gap-10 lg:grid-cols-12 lg:gap-12"><div class="lg:col-span-4"><p class="font-mono text-label text-signal-mid uppercase">Antes de escolher</p><h2 id="duvidas-title" class="mt-4 max-w-[9ch] font-display text-title font-bold leading-[0.92] text-bone">Dúvidas comuns.</h2></div><div class="lg:col-span-7 lg:col-start-6" data-accordion>{iptvFaqs.map((faq, i) => <div class="border-b border-line" data-accordion-item><h3><button type="button" class="group flex w-full items-start justify-between gap-3 py-5 text-left text-base font-medium text-bone sm:items-center sm:gap-6 sm:py-6 sm:text-lg" aria-expanded="false" aria-controls={`iptv-faq-${i}`} id={`iptv-faq-button-${i}`} data-accordion-trigger>{faq.question}<span class="grid size-9 shrink-0 place-items-center rounded-full border border-line-strong transition-[rotate,background-color,color] duration-500 group-aria-expanded:rotate-45 group-aria-expanded:bg-signal group-aria-expanded:text-ink"><Icon name="plus" /></span></button></h3><div id={`iptv-faq-${i}`} role="region" aria-labelledby={`iptv-faq-button-${i}`} class="h-0 overflow-hidden" data-accordion-panel><p class="max-w-[60ch] pb-6 text-sm leading-relaxed text-mute sm:text-base">{faq.answer}</p></div></div>)}</div></div></section>
