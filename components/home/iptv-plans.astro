---
import Button from '@/components/shared/ui/button.astro';
import { iptvBrand, iptvCommercial, iptvPlans, iptvWhatsAppHref } from '@/data/iptv';
---

<section id="planos" class="bg-ink-2 py-20 sm:py-24 md:py-36" aria-labelledby="planos-title">
  <div class="shell"><div class="flex flex-wrap items-end justify-between gap-6 sm:gap-8"><div><p class="font-mono text-label text-signal-mid uppercase">Planos para sua rotina</p><h2 id="planos-title" class="mt-4 max-w-[10ch] font-display text-title font-bold leading-[0.92] text-bone">Comece pelo que combina com você.</h2></div><p class="max-w-[32ch] text-sm text-mute sm:text-base">{iptvBrand.name} · {iptvCommercial.availabilityLabel}.</p></div>
    <div class="mt-10 grid gap-3 sm:mt-12 lg:grid-cols-3">{iptvPlans.map((plan) => <article class:list={["flex min-h-[22rem] flex-col border p-5 sm:min-h-96 sm:p-6 md:p-8", plan.featured ? 'border-signal bg-signal text-text' : 'border-line-strong bg-ink']}><span class="font-mono text-label uppercase opacity-70">{plan.emphasis}</span><h3 class="mt-auto font-display text-4xl font-bold">{plan.name}</h3><p class="mt-3 max-w-[25ch] opacity-75">{plan.description}</p><div class="mt-6 border-t border-current/20 pt-5 text-sm"><p class="font-medium">R$ {plan.price}</p><p class="mt-1 opacity-70">{plan.billing}</p><p class="mt-1 opacity-70">{plan.features.length ? plan.features.join(' · ') : iptvCommercial.pricingLabel}</p></div><Button label="Falar com atendimento" href={iptvWhatsAppHref} target="_blank" rel="noopener noreferrer" variant={plan.featured ? 'bone' : 'outline'} class="mt-8 w-full" /></article>)}</div>
  </div>
</section>
