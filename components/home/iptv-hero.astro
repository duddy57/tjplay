---
import { Image } from 'astro:assets';
import Button from '@/components/shared/ui/button.astro';
import mockup from '@/assets/images/TjplayMoockup.png';
import heroBackground from '@/assets/images/releases/bg-banner.png';
import { iptvHero, iptvWhatsAppHref } from '@/data/iptv';
---

<section
  class="iptv-hero relative overflow-hidden pt-36 pb-16 sm:pt-32 sm:pb-20 md:pt-40 md:pb-32"
  aria-labelledby="iptv-hero-title">
  <div class="iptv-hero-background" aria-hidden="true">
    <Image src={heroBackground} alt="" class="iptv-hero-background-image" loading="eager" />
    <div class="iptv-hero-background-overlay"></div>
  </div>
  <div class="shell relative z-10 grid items-end gap-14 lg:grid-cols-12">
    <div class="lg:col-span-8" data-intro>
      <p class="font-mono text-label text-signal uppercase tracking-[0.14em]">{iptvHero.eyebrow}</p>
      <h1
        id="iptv-hero-title"
        class="mt-5 max-w-[9ch] whitespace-pre-line font-display text-[clamp(4rem,10vw,9.5rem)] leading-[0.86] font-extrabold tracking-[-0.07em] text-[var(--color-hero-foreground)]">
        {iptvHero.title}
      </h1>
      <p class="iptv-hero-copy mt-8 max-w-[42ch] text-lead text-[var(--color-hero-copy)]">{iptvHero.body}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button label={iptvHero.primaryCta} href={iptvWhatsAppHref} target="_blank" rel="noopener noreferrer" />
        <a
          class="iptv-hero-secondary rounded-full border border-[var(--color-hero-line)] px-5 py-3.5 text-sm font-medium text-[var(--color-hero-foreground)] transition-colors hover:border-signal hover:text-signal"
          href={iptvWhatsAppHref}
          target="_blank"
          rel="noopener noreferrer">
          {iptvHero.secondaryCta}
        </a>
      </div>
    </div>
    <div class="relative min-h-64 sm:min-h-72 lg:col-span-4 lg:col-start-9 lg:min-h-120" data-reveal>
      <div class="iptv-hero-mockup">
        <Image
          src={mockup}
          alt="Interface da TjIptv exibida em um laptop"
          class="w-full max-w-none h-auto object-contain"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .iptv-hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-ink-2);
  }

  :global(.iptv-hero-background-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: blur(3px);
    transform: scale(1.04);
  }

  .iptv-hero-background-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.56) 45%, rgb(0 0 0 / 0.22) 100%),
      linear-gradient(180deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0.6));
  }

  .iptv-hero-copy {
    text-shadow: 0 0.12rem 0.8rem rgb(0 0 0 / 0.55);
  }

  .iptv-hero-secondary {
    text-shadow: 0 0.08rem 0.55rem rgb(0 0 0 / 0.42);
    box-shadow: 0 0.75rem 1.75rem -1.25rem rgb(0 0 0 / 0.72);
  }

  .iptv-hero-mockup {
    position: relative;
    width: 135%;
    height: auto;
    margin-top: 0;
    margin-left: auto;
    right: -5%;
  }

  @media (width < 30rem) {
    .iptv-hero-mockup {
      width: 100%;
      right: 0%;
    }
  }

  @media (width >= 64rem) {
    .iptv-hero-mockup {
      position: absolute;
      top: 50%;
      right: 0;
      width: min(180%, 56rem);
      height: auto;
      margin: 0;
      transform: translateY(-58%);
    }
  }
</style>
